<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.fiberpulse.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_EXECUTABLE__</string>
    <string>--background</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>Crashed</key><true/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIRECTORY__/launchd.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIRECTORY__/launchd.stderr.log</string>
</dict>
</plist>
