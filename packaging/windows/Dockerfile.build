FROM golang:1.26.7-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=0.1.1-dev
ARG SHARE_URL=
ARG UPDATE_FEED_URL=
ARG UPDATE_PUBLIC_KEY=
RUN mkdir -p /out \
    && GOOS=windows GOARCH=amd64 CGO_ENABLED=1 CC=x86_64-w64-mingw32-gcc \
       go build -trimpath -buildvcs=false -ldflags="-s -w -H=windowsgui -X main.version=${VERSION} -X main.sharingEndpoint=${SHARE_URL} -X main.updateFeedURL=${UPDATE_FEED_URL} -X main.updatePublicKey=${UPDATE_PUBLIC_KEY}" -o /out/fiberpulse.exe ./cmd/fiberpulse \
    && GOOS=windows GOARCH=amd64 CGO_ENABLED=0 \
       go build -trimpath -buildvcs=false -ldflags="-s -w -H=windowsgui" -o /out/fiberpulse-updater.exe ./cmd/fiberpulse-updater

ENTRYPOINT ["/bin/sh", "-c", "cp /out/*.exe /artifacts/"]
